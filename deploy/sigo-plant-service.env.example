# Variáveis do plant-service (copiar para /etc/default/sigo-plant-service)
#
# PLANT_SERVICE_TOKEN=...          # obrigatório em produção (mesmo valor da API)
# ENVIRONMENT=production
#
# Assistente Ollama (já a correr em 127.0.0.1:11434 no VPS SIGO)
PLANT_AI_ENABLED=1
OLLAMA_HOST=http://127.0.0.1:11434
PLANT_AI_MODEL=qwen2.5:7b
PLANT_AI_TIMEOUT=90
PLANT_AI_MAX_PAGES=8
PLANT_AI_MIN_ROOMS=1
