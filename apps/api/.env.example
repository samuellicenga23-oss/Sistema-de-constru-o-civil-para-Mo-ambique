DATABASE_URL=postgres://postgres:postgres@localhost:5432/sigo
PORT=4100
SESSION_COOKIE_SECRET=change-me-in-production
PLANT_SERVICE_URL=http://localhost:8001
# Produção: mesmo valor que o PLANT_SERVICE_TOKEN definido no ambiente do plant-service — sem
# isto, qualquer coisa que consiga alcançar a porta do plant-service pode chamá-lo directamente.
PLANT_SERVICE_TOKEN=
UPLOADS_DIR=./uploads
# Produção: define o(s) domínio(s) reais separados por vírgula (ex: https://app.sigo.co.mz).
# Sem isto em produção, o CORS fica fechado por omissão — o próprio frontend (mesma origem via
# Nginx) não precisa de CORS, só é preciso se algum outro domínio for chamar a API directamente.
CORS_ORIGIN=
NODE_ENV=production
# Login com Google (opcional — sem estas três, o botão "Entrar com Google" fica escondido).
# Criar em https://console.cloud.google.com/apis/credentials — tipo "Web application".
# GOOGLE_REDIRECT_URI tem de ser registado ali, byte a byte igual, em "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://SEU_DOMINIO/api/auth/google/callback
# Só necessário em desenvolvimento (Vite noutra porta que a API) — deixar vazio em produção.
FRONTEND_URL=
